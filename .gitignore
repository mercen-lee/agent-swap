/*.dSYM/
/*.xcarchive/
/*.dmg
/*.pkg
/*.p12
/*.pfx
/*.mobileprovision
/*.provisionprofile
/*.key
/*.pem
/*.keychain
/*.keychain-db

# Local secrets and copied provider / application state (not test fixtures)
/.env
/.env.*
!/.env.example
!/.env.sample
!/.env.template
/.claude/
/.codex/
/.claude.json
/.credentials.json
/auth.json
/state.json
/instance.lock
/.agentswap-signing-identity
/Library/Application Support/AgentSwap/
/Library/Application Support/Claude/
