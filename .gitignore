# macOS metadata
.DS_Store
._*

# Xcode / SwiftPM build output and personal workspace state
.build/
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xccheckout
*.xcscmblueprint
*.xcactivitylog
*.xcresult/
**/.swiftpm/configuration/registries.json
**/.swiftpm/security/
